# --- Database (local PostgreSQL) ---
DATABASE_URL="postgresql://lecture:lecture@localhost:5432/lecturenotes"

# --- Gnani / Vachana speech-to-text ---
GNANI_API_KEY=your_gnani_api_key_here
# Optional overrides
# GNANI_MODEL=prisma-v3.0
# GNANI_LANGUAGE=en-IN,hi-IN   # up to 4 codes; use indic-auto to auto-detect
# GNANI_BASE_URL=https://api.vachana.ai

# --- Sarvam AI (insights + Class Pulse) ---
SARVAM_API_KEY=your_sarvam_api_key_here
# Optional overrides
# SARVAM_MODEL=sarvam-105b-conversations   # or sarvam-105b (slower, deeper reasoning)
# SARVAM_BASE_URL=https://api.sarvam.ai

# --- Gnani TTS (Class Pulse read-aloud) ---
# Uses the same GNANI_API_KEY as speech-to-text.
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_VOICE=Vasudha   # optional global override (Timbre v3.0 voice only)

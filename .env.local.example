# --- Database (AWS RDS PostgreSQL) ---
DATABASE_URL="postgresql://<user>:<password>@<rds-endpoint>:5432/lecturenotes?sslmode=no-verify"

# --- AWS ---
AWS_REGION=us-west-2
AUDIO_BUCKET=your-audio-bucket
# Secret holding {"MISTRAL_API_KEY":"..."}; used instead of MISTRAL_API_KEY on AWS
MISTRAL_SECRET_ARN=arn:aws:secretsmanager:us-west-2:<account>:secret:lecture-notes/mistral-api-key-XXXXXX

# --- Async pipeline (optional) ---
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/<account>/lecture-notes-processing
PROCESS_SECRET=change-me

# --- Mistral API Key (local dev only; omit on AWS to use Secrets Manager) ---
MISTRAL_API_KEY=your_mistral_api_key_here
